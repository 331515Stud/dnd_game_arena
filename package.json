{
  "name": "dnd-game-arena",
  "private": true,
  "version": "0.1.0",
  "description": "D&D 5e Game Arena: Путеводитель (Vite) + Листы персонажей (Next.js)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:guide": "npm --workspace apps/guide-vite run dev",
    "dev:characters": "npm --workspace apps/characters-next run dev",
    "build:guide": "npm --workspace apps/guide-vite run build",
    "build:characters": "npm --workspace apps/characters-next run build"
  }
}
